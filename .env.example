# Copy to .env and restart with `npx expo start --clear`.
# EXPO_PUBLIC_ vars are inlined into the app bundle, so only ever put the
# anon key here -- never the service_role key, and never a model API key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# The model keys below are NOT part of this file. They are set as Supabase
# secrets so they stay server-side, and are listed here only as a reminder:
#
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-2.5-flash     # optional
#
# To use Claude instead:
#   supabase secrets set LLM_PROVIDER=anthropic
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ANTHROPIC_MODEL=claude-opus-5     # optional
